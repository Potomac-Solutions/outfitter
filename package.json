{
  "name": "outfitter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rent and book: kayaks, paddleboards and bikes by the day, with sizing, a signed waiver and a counter that hands them out. A Potomac Solutions platform, built on the kit and Zubra.",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node bin/seed.js",
    "demo": "node bin/seed.js --fresh && node server.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "design-check": "node scripts/design-check.js"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@journey-to-code/symbology": "0.2.0",
    "@potomac-solutions/kit": "github:Potomac-Solutions/potomac-kit#a4901ea3b31165c2cd5f5e9a35e9876332020ab9",
    "@zubra/compiler": "^6.0.5",
    "@zubra/runtime": "^6.0.5",
    "@zubra/server": "^6.0.5",
    "@zubra/sync": "^6.0.5"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  },
  "engines": {
    "node": "26.x"
  }
}
