{
  "name": "outfitter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rent and book: kayaks, paddleboards and bikes by the day, with sizing, a signed waiver and a counter that hands them out. A Potomac Solutions platform, built on the kit and Zubra.",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node bin/seed.js",
    "demo": "node bin/seed.js --fresh && node server.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\""
  },
  "dependencies": {
    "@journey-to-code/symbology": "0.2.0",
    "@potomac-solutions/kit": "github:Potomac-Solutions/kit#fd196d83645005f45b6bd7b4c07b35a2afd91ac5",
    "@zubra/compiler": "^5.13.1",
    "@zubra/runtime": "^5.13.1",
    "@zubra/server": "^5.13.1",
    "@zubra/sync": "^5.13.1"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
