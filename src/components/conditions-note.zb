<!--
  The staff's note about today (the water, the wind, the trails), live. A Sync document only the
  server writes ('use collection conditions by shop'): when the counter posts a new note, every
  open page shows it without a reload. The server HTML already has it (`text-now`).
-->
<script>
  'use collection conditions by shop'
  import { from } from '@zubra/runtime'

  let text = from(textNow)
  let at = from(atNow)

  // The server can't format a time, so it sends it already in words (`at-label`); the element
  // formats a new one itself when a note is posted live.
  const when = at === atNow ? atLabel : at ? new Date(at).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', timeZone }) : ''
</script>
<style>
  :host { display: block; }
  aside { display: grid; gap: 0.2rem; padding: 0.9rem 1.1rem; border-radius: var(--radius, 0.75rem); background: var(--note, #e6f4f1); border-left: 4px solid var(--primary, #0f3d5e); }
  p { margin: 0; }
  small { color: var(--muted-foreground, #526473); }
</style>
<conditions-note shop="" text-now="" at-now={0} at-label="" time-zone="America/New_York">
  <aside zb-if={text} aria-live="polite">
    <p><strong>Today on the lake:</strong> {text}</p>
    <small zb-if={when}>Posted at {when}</small>
  </aside>
</conditions-note>
